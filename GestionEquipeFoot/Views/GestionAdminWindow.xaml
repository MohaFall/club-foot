<Window x:Class="GestionEquipeFoot.Views.GestionAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Admin" Height="500" Width="400" WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Border Background="White" CornerRadius="10" Padding="20" Margin="30" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Height="300" >

            <TextBlock Text="Gestion Administrateur" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0 0 0 0" Foreground="#333"/>

            <Button Content="Gérer les Équipes" Height="45" Background="#2196F3" Foreground="White" Margin="0 10" Click="BtnGererEquipes_Click"/>
            <Button Content="Gérer les Joueurs" Height="45" Background="#2196F3" Foreground="White" Margin="0 10" Click="BtnGererJoueurs_Click"/>
            <Button Content="Gérer les Rencontres" Height="45" Background="#2196F3" Foreground="White" Margin="0 10" Click="BtnGererRencontres_Click" />

            <Button Content="Retour" Height="35" Background="#F44336" Foreground="White" Margin="0 30 0 0" Click="BtnRetour_Click"/>
        </StackPanel>
    </Border>
</Window>
