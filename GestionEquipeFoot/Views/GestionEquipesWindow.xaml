<Window x:Class="GestionEquipeFoot.Views.GestionEquipesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Équipes" Height="500" Width="700" WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Border Background="White" CornerRadius="10" Padding="15" Margin="20" BorderBrush="#DDD" BorderThickness="1">
        <DockPanel>

            <Button Content="Retour" Height="40" Width="100" Background="#2196F3" Foreground="White" Margin="0 0 0 10"
                    DockPanel.Dock="Top" HorizontalAlignment="Left" Click="BtnRetour_Click"/>

            

            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20">
                    <Button x:Name="BtnAjouter" Content="Ajouter" Width="100" Height="40" Margin="10" Background="#4CAF50" Foreground="White" Click="BtnAjouter_Click"/>
                    <Button x:Name="BtnModifier" Content="Modifier" Width="100" Height="40" Margin="10" Background="#FFC107" Foreground="Black" Click="BtnModifier_Click"/>
                    <Button x:Name="BtnSupprimer" Content="Supprimer" Width="100" Height="40" Margin="10" Background="#F44336" Foreground="White" Click="BtnSupprimer_Click"/>
                </StackPanel>
                <DataGrid x:Name="EquipesDataGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          AlternatingRowBackground="#F0F0F0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="50"
                          FontSize="14"
                          MaxHeight="200"
                          Margin="0 10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdEq}" Width="80" />
                        <DataGridTextColumn Header="Nom de l'Équipe" Binding="{Binding NomEq}" Width="2*" />
                        <DataGridTextColumn Header="Classement" Binding="{Binding PositionEq}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                
            </StackPanel>

        </DockPanel>
    </Border>
</Window>
