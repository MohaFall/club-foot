<Window x:Class="GestionEquipeFoot.Views.RencontreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liste des Rencontres" Height="450" Width="750" WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Border Background="White" CornerRadius="10" Padding="15" Margin="20" BorderBrush="#DDD" BorderThickness="1">
        <DockPanel>

            <Button Content="Retour" Height="40" Width="100" Background="#2196F3" Foreground="White" Margin="0 0 0 10"
                    DockPanel.Dock="Top" HorizontalAlignment="Left" Click="BtnRetour_Click"/>

            <DataGrid x:Name="RencontresDataGrid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          Margin="10">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateRencontre}" Width="150"/>
                    <DataGridTextColumn Header="Équipe 1" Binding="{Binding Equipe1}" Width="*"/>
                    <DataGridTextColumn Header="Score 1" Binding="{Binding ScoreEquipe1}" Width="80"/>
                    <DataGridTextColumn Header="Équipe 2" Binding="{Binding Equipe2}" Width="*"/>
                    <DataGridTextColumn Header="Score 2" Binding="{Binding ScoreEquipe2}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>


        </DockPanel>
    </Border>
</Window>
