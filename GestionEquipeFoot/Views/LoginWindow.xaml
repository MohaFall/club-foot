<Window x:Class="GestionEquipeFoot.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Height="400" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Border Background="White" CornerRadius="10" Padding="20" Margin="40" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Connexion" FontSize="24" FontWeight="Bold" Foreground="#333" TextAlignment="Center" Margin="0 0 0 20"/>

            <TextBlock Text="Login :" Margin="0 0 0 5"/>
            <TextBox x:Name="LoginTextBox" Height="30" Margin="0 0 0 15"/>

            <TextBlock Text="Mot de Passe :" Margin="0 0 0 5"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0 0 0 20"/>

            <Button Content="Se connecter" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold" Click="Connexion_Click"/>
        </StackPanel>
    </Border>
</Window>
